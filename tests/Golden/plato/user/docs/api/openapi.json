                                        }
                                    },
                                    "required": [
                                        "code",
                                        "data",
                                        "msg"
                                    ],
                                    "type": "object"
                                }
                            }
                        },
                        "description": "The request carries no authenticated identity."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "summary": "Get user information",
                "tags": [

    "paths": {
        "/user/disable_account": {
            "post": {
                "deprecated": false,
                "description": "A write operation that requires an authenticated identity.",
                "operationId": "user.disable_account",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "id": {
                                        "description": "User ID, positive integer.",
                                        "minimum": 1,
                                        "type": "integer"
                                    }
                                },
                                "required": [
                                    "id"
                                ],
                                "type": "object"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "code": {
                                            "example": 0,
                                            "type": "integer"
                                        },
                                        "data": {
                                            "properties": {
                                                "enabled": {
                                                    "type": "boolean"
                                                },
                                                "id": {
                                                    "type": "integer"
                                                },
                                                "note": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "profile": {
                                                    "properties": {
                                                        "nickname": {
                                                            "type": "string"
                                                        }
                                                    },
                                                    "required": [
                                                        "nickname"
                                                    ],
                                                    "type": "object"
                                                },
                                                "roles": {
                                                    "items": {
                                                        "properties": {
                                                            "id": {
                                                                "type": "integer"
                                                            },
                                                            "name": {
                                                                "type": "string"
                                                            }
                                                        },
                                                        "required": [
                                                            "id",
                                                            "name"
                                                        ],
                                                        "type": "object"
                                                    },
                                                    "type": "array"
                                                },
                                                "status": {
                                                    "enum": [
                                                        "active",
                                                        "disabled"
                                                    ],
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "enabled",
                                                "id",
                                                "note",
                                                "profile",
                                                "roles",
                                                "status"
                                            ],
                                            "type": "object"
                                        },
                                        "msg": {
                                            "example": "successful",
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "code",
                                        "data",
                                        "msg"
                                    ],
                                    "type": "object"
                                }
                            }
                        },
                        "description": "Successful response"
                    },
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "code": {
                                            "example": 401,
                                            "type": "integer"
                                        },
                                        "data": {
                                            "type": "null"
                                        },
                                        "msg": {
                                            "example": "Unauthorized",
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "code",
                                        "data",
                                        "msg"
                                    ],
                                    "type": "object"
                                }
                            }
                        },
                        "description": "The request carries no authenticated identity."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "summary": "Disable an account",
                "tags": [
                    "user"
                ]
            }
        },
